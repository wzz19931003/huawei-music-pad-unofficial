{
  "name": "huawei-music-desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "Wmusic：兼容华为音乐的独立第三方 Windows 客户端（与华为无隶属、合作或授权关系 · 需自备账号与会员 · 不提供音源）",
  "license": "AGPL-3.0-only",
  "desktopName": "huawei-music-desktop.desktop",
  "author": {
    "name": "Huawei Music Desktop (unofficial)"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "npm run start",
    "start": "npm run build && node scripts/start-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build && node scripts/build-lyrics-preload.mjs",
    "test": "node --test test/*.test.mjs",
    "test:unit": "vitest run src/renderer",
    "test:undici-security": "node --test test/undici-security-regressions.test.mjs test/network-security-report-gates.test.mjs",
    "test:network-security": "node tools/test-wmusic-network-security.mjs",
    "test:desktop-lyrics": "node --test test/desktop-lyrics-*.test.mjs && vitest run src/main/desktop-lyrics.test.ts src/preload/desktop-lyrics.test.ts src/preload/desktop-lyrics-wiring.test.ts src/renderer/DesktopLyrics.test.tsx src/renderer/DesktopLyricsToggle.test.tsx src/renderer/desktop-lyrics-control.test.ts src/renderer/desktop-lyrics-publisher.test.ts src/renderer/lib/player.modes.test.ts",
    "test:electron": "npm run build && node scripts/run-electron-tests.mjs smoke",
    "test:electron-ui": "npm run build && node scripts/run-electron-tests.mjs ui",
    "test:electron-business": "npm run build && node scripts/run-electron-tests.mjs business",
    "test:electron-favorites": "npm run build && node scripts/run-electron-tests.mjs favorites",
    "test:release-contents": "npm run build && node scripts/check-release-contents.mjs",
    "test:safe-storage-restart": "npm run build && node scripts/run-electron-tests.mjs storage",
    "test:login-navigation": "node scripts/run-electron-tests.mjs navigation",
    "test:login-callback": "npm run build && node scripts/run-electron-tests.mjs callback",
    "test:login-live": "npm run build && node scripts/run-electron-tests.mjs live",
    "test:login-cancel": "npm run build && node scripts/run-electron-tests.mjs cancel",
    "dist": "node scripts/build-desktop.mjs",
    "dist:win": "node scripts/build-desktop.mjs win",
    "dist:linux": "node scripts/build-desktop.mjs linux",
    "dist:mac:x64": "node scripts/build-desktop.mjs mac x64",
    "dist:mac:arm64": "node scripts/build-desktop.mjs mac arm64",
    "test:packaged": "node scripts/run-electron-tests.mjs packaged",
    "test:windows-installer": "node scripts/check-windows-installer.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "probe:login": "node scripts/probe-login.mjs",
    "probe:music": "node scripts/probe-music.mjs",
    "auth:lab": "node scripts/auth-lab.mjs",
    "test:browser": "node scripts/test-callback-browser.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "test:pad-ui": "npm run build && node tools/test-pad-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.3.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "pe-library": "0.4.1",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resedit": "1.7.2",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "build": {
    "appId": "org.hwmusicdesktop.unofficial",
    "productName": "Wmusic",
    "asar": true,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "wzz19931003",
      "repo": "huawei-music-pad-unofficial",
      "releaseType": "release"
    },
    "artifactName": "${name}-${version}-${os}-${arch}-unofficial.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!**/.local/**",
      "!**/research/**",
      "!**/docs/**",
      "!**/test/**",
      "!**/scripts/**",
      "!src/**",
      "!**/AGENTS.md",
      "!**/README.md",
      "!**/tsconfig.json",
      "!**/electron.vite.config.ts"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "artifactName": "Wmusic-${version}-${os}-${arch}-setup-unofficial.${ext}"
    },
    "nsis": {
      "include": "build/installer-compat.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true,
      "executableName": "huawei-music-desktop",
      "category": "AudioVideo;Audio;Music",
      "synopsis": "Wmusic: independent third-party Huawei Music client",
      "desktop": {
        "entry": {
          "Name": "Wmusic",
          "Comment": "独立第三方客户端，与华为无隶属、合作或授权关系"
        }
      }
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "undici": "7.30.2"
  },
  "overrides": {
    "node-gyp": {
      "undici": "6.29.1"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    }
  }
}
